# 复制成 .env 就能用：  Windows: copy .env.example .env   /   macOS·Linux: cp
#
# ⚠️ **这个文件里没有、也不该有任何 API key。**
#    Jev 和 DeepSeek 的 key 都填在网页右上角「设置」里，存在你自己的浏览器，
#    每次请求带给后端。服务端不保存、也不读这里的 key —— 所以
#    「分享前记得清掉 key」「别把 .env 提交上去」这类事，这里根本不存在。
#
#    想换 key：打开网页 → 右上角「设置」→ 填 → 保存。就这样。
#    别人用你的部署也一样操作，各花各的钱。

# --- Jev transport -----------------------------------------------------------
# openrouter：不用 TypeSafe 账号，OpenRouter 注册充值即可用（推荐）
# typesafe  ：官方直连，需要 TypeSafe 账号且必须先有 credits 才允许建 key
JEV_TRANSPORT=openrouter

OPENROUTER_BASE_URL=https://openrouter.ai/api

# 仅在 JEV_TRANSPORT=typesafe 时会用到
# D13：固定版本号，不要用 ~typesafe/jev-latest / jev-latest 别名
JEV_MODEL=typesafe/jev-1.13

# 留空 = 跟随**系统代理**（Windows 设置里那个）。
# ⚠️ 留空不是「直连」：httpx 默认会读系统代理，即使显式传 None 也一样（实测过）。
#    想强制直连：设 NO_PROXY=openrouter.ai,api.typesafe.ai
#    想强制用某个代理：填在下面（会盖过系统设置）
# 排查：Jev 一直超时的话，先看 Windows 代理设置是不是指向一个已经关掉的端口。
JEV_PROXY=

# --- DeepSeek（语言处理层 + 备用判定后端） ------------------------------------
# 和 Jev 不是同一个平台，要单独申请：https://platform.deepseek.com/api_keys
# 不填也能玩，只是少掉「二次复核 / 进度提示 / 通关判定」。
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled
# 显式设上限，避免偶发输出截断导致 JSON 解析失败（实测踩过一次）
DEEPSEEK_MAX_TOKENS=1024

# --- 通关判定（§4.5b） --------------------------------------------------------
# 玩家自述真相 → DeepSeek 打分，≥ 此值算通关（偏松是刻意的，见 config.py）
SOLVE_PASS_SCORE=0.75
SOLVE_MAX_CHARS=1000

# --- 判定阈值 ----------------------------------------------------------------
# 判定是三态：是 / 不是 / 不重要。「是也不是」由代码从置信度差派生（恢复 D7）。
# 取值属 §12 第 6 项，已用两锅汤 49 题扫描：0.20 最优（0.30 起准确率开始掉）
JEV_BOTH_MARGIN=0.20
JEV_IRRELEVANT_MIN=0.50
JEV_ABSTAIN=0.45
JEV_CONFIDENT=0.70

# --- 选择题（斜杠语法） -------------------------------------------------------
# 玩家在候选之间写 `/`：「他是自杀/被杀」→ 一次 Jev Choice，在候选里挑一个。
# 识别是形式问题（0 成本），语义仍整句交给 Jev —— 不要再上 DeepSeek 先判是不是选择题，
# 那是 +¥0.0004/问、+1 次往返，而延迟 P50 已经 700ms 超标。
MAX_CHOICE_OPTIONS=4
# ⚠️ 这两个阈值**没有校准数据**（是从是非题那套借来的形状），所以取保守值：
#    拿不准就回「不确定」，而不是给一个言之凿凿的错答案。
JEV_CHOICE_MIN=0.50
JEV_CHOICE_MARGIN=0.15

# --- 二次判定（Jev 弃权 / low_confidence 时叫 DeepSeek 复核） ------------------
# 触发：主判定弃权，或最大概率 < JEV_CONFIDENT
# policy=abstain：两边不一致就弃权（默认，保守）
# policy=deepseek：两边不一致时让 DeepSeek 拍板（风险高，要有数据支撑再用）
SECOND_OPINION=1
SECOND_OPINION_POLICY=abstain
SECOND_CONFIDENT=0.70
# soften=0：二次说「是也不是」时不软化主判定的明确答案（实测更好，理由见 config.py）
SECOND_SOFTEN=0
# 主判定是 both 时，二次要多久自信才能推翻它、给出明确答案（>1 = 绝不推翻）
SECOND_BOTH_OVERRIDE=0.95

# --- 花钱接口的限流（见 soup/ratelimit.py）-------------------------------------
# 每分钟允许多少次「判定 / 提示 / 通关判定」，0 = 关闭。
# 默认 60：人打字最猛就一分钟十几问，单人玩毫无感觉；但足以把脚本刷
# 从上千元/天压到几十元 —— 它防的是自动化，不是防人。
# 身份按「请求里带的 key」算，没带 key 才按 IP（同一个 NAT 后面的人不会互相伤害）。
RATE_LIMIT_PER_MIN=60
